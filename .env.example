# Supabase Configuration
SUPABASE_URL=your_supabase_url
# REQUIRED. All database and storage access uses the service role key.
# The server refuses to boot without it — there is no anon fallback by design.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Do NOT add SUPABASE_ANON_KEY. The anon role has zero permissions on this
# project (RLS enabled + all grants revoked, July 2026). See CLAUDE.md.

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# API Keys for Recipe Features
SPOONACULAR_API_KEY=your_spoonacular_api_key

# Feature flag to enable/disable Spoonacular API calls
# Set to 'false' to disable and avoid hitting API rate limits
# When disabled, /api/recipes/suggestions returns empty results gracefully
ENABLE_SPOONACULAR_RECIPES=false

# Instagram Recipe Import (iOS Shortcuts)
RAPIDAPI_KEY=your_rapidapi_key_for_instagram
OPENROUTER_API_KEY=your_openrouter_api_key_for_ai

# Google Gemini for Video Analysis
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
APIFY_API_TOKEN=your_apify_api_token_for_instagram_scraping

# Optional: Fireworks AI for image generation
FIREWORKS_API_KEY=your_fireworks_api_key

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS and shortcut configuration
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# iOS Shortcut Configuration
SHORTCUT_TOKEN_PREFIX=scut_
MAX_RECIPES_PER_DAY_FREE=5

# Trigger rebuild - Railway builder failure workaround